# Dash Platform Configuration
# Copy this file to .env and fill in your values

# Data contract ID for your application
VITE_DATA_CONTRACT_ID=your_data_contract_id_here

# Identity ID (the public identifier)
VITE_IDENTITY_ID=your_identity_id_here

# Private key for the identity (keep this secret!)
# Only needed if you want to sign transactions directly without extension
VITE_IDENTITY_PRIVATE_KEY=your_private_key_here

# Network to use (testnet or mainnet)
VITE_NETWORK=testnet